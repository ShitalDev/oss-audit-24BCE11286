#!/bin/bash
# Script 2: FOSS Package Inspector
# Author: [SHITAL DAS] | Reg No: [24BCE11286]
# Course: Open Source Software
# Description: Checks if a package is installed and shows its details

# ─────────────────────────────────────────
# VARIABLE — the package we want to inspect
# ─────────────────────────────────────────
PACKAGE="git"    # We are inspecting Git

echo "=================================================="
echo "       FOSS PACKAGE INSPECTOR                    "
echo "=================================================="
echo ""

# ─────────────────────────────────────────
# IF-ELSE — check if the package is installed
# dpkg -l lists installed packages
# grep -q searches silently (no output, just true/false)
# ─────────────────────────────────────────
if dpkg -l "$PACKAGE" 2>/dev/null | grep -q "^ii"; then
    echo "  ✔ '$PACKAGE' IS installed on this system."
    echo ""
    echo "  Package Details:"
    echo "  ----------------"

    # dpkg -s gives detailed info about the package
    # grep -E filters only the lines we care about
    dpkg -s "$PACKAGE" | grep -E 'Package|Version|License|Maintainer|Homepage|Description'

else
    echo "  ✘ '$PACKAGE' is NOT installed."
    echo "  To install it, run: sudo apt install $PACKAGE"
fi

echo ""
echo "--------------------------------------------------"
echo "  OPEN SOURCE PHILOSOPHY NOTE"
echo "--------------------------------------------------"

# ─────────────────────────────────────────
# CASE STATEMENT — prints philosophy note based on package name
# Like a switch statement — matches the variable to a pattern
# ─────────────────────────────────────────
case $PACKAGE in
    git)
        echo "  Git: Born from frustration with proprietary tools."
        echo "  Linus Torvalds built it in 10 days so the Linux"
        echo "  community would never depend on closed software again."
        echo "  Licensed under GPL v2 — free forever."
        ;;
    httpd | apache2)
        echo "  Apache: The web server that built the open internet."
        echo "  Powers nearly 30% of all websites globally."
        echo "  Licensed under Apache 2.0."
        ;;
    mysql | mysql-server)
        echo "  MySQL: Open source at the heart of millions of apps."
        echo "  Uses a dual license — GPL v2 for open use,"
        echo "  commercial license for proprietary products."
        ;;
    firefox)
        echo "  Firefox: A nonprofit browser fighting for an open web."
        echo "  Built by Mozilla — a foundation, not a corporation."
        echo "  Licensed under MPL 2.0."
        ;;
    vlc)
        echo "  VLC: Plays anything — built by students in Paris."
        echo "  Created because no free tool could stream video"
        echo "  over their university network. Licensed under LGPL."
        ;;
    python3 | python)
        echo "  Python: A language shaped entirely by community."
        echo "  Governed by the Python Software Foundation."
        echo "  Licensed under the permissive PSF License."
        ;;
    *)
        # Default case — if no match found
        echo "  $PACKAGE: An open-source tool contributing to"
        echo "  the free software ecosystem."
        ;;
esac

echo ""
echo "=================================================="
echo "  End of Package Inspector"
echo "=================================================="
